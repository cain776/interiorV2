{
  "name": "interior-backend",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch --env-file=.env src/server.ts",
    "build": "tsc -p tsconfig.build.json",
    "start": "node dist/server.js",
    "migrate": "tsx --env-file=.env src/scripts/migrate.ts",
    "migrate:test": "tsx --env-file=../.env.test src/scripts/migrate.ts",
    "backfill:line-items": "tsx --env-file=.env src/scripts/backfill-line-items.ts",
    "test": "node --import tsx --test src/tests/*.test.ts",
    "test:integration": "vitest run --config vitest.config.ts",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@fastify/cookie": "^11.0.2",
    "@fastify/helmet": "^13.0.2",
    "@fastify/rate-limit": "^10.3.0",
    "@fastify/session": "^11.1.0",
    "@fastify/static": "^8.1.1",
    "@types/connect-pg-simple": "^7.0.3",
    "bcryptjs": "^3.0.3",
    "connect-pg-simple": "^10.0.0",
    "fastify": "^5.6.0",
    "pg": "^8.13.1"
  },
  "devDependencies": {
    "@types/bcryptjs": "^2.4.6",
    "@types/node": "^20.17.10",
    "@types/pg": "^8.11.10",
    "tsx": "^4.21.0",
    "typescript": "^5.7.2",
    "vitest": "^4.1.5"
  }
}
