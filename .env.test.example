# 테스트 전용 DB. 운영/개발 DB 와 반드시 별도여야 함.
# 안전장치: helpers/db.ts 에서 DATABASE_URL 에 'test' 가 포함되지 않으면 throw.
#
# 사전 준비:
#   createdb interior_test
#   npm run migrate:test
#
# 실행:
#   npm run test:integration

DATABASE_URL="postgresql://postgres:postgres@localhost:5432/interior_test"
SESSION_SECRET="test-secret-at-least-32-characters-long"
